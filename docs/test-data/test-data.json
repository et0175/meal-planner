  "diets": [
    {
      "id": "mediterranean",
      "name": "Mediterranean",
      "description": "Emphasises vegetables, fruits, whole grains, legumes, nuts, and olive oil; moderate fish and poultry; limited red meat and sweets.",
      "macroGuidance": { "proteinPct": 15, "fatPct": 35, "carbsPct": 50 },
      "applicableMacroGuidance": true
    },
    {
      "id": "plant-based",
      "name": "Plant-based / Flexitarian",
      "description": "Primarily plant-derived foods — vegetables, fruits, grains, legumes, nuts — with occasional or reduced animal products.",
      "macroGuidance": { "proteinPct": 15, "fatPct": 25, "carbsPct": 60 },
      "applicableMacroGuidance": true
    },
    {
      "id": "mind",
      "name": "MIND diet",
      "description": "Hybrid of Mediterranean and DASH focused on brain-protective foods: leafy greens, berries, nuts, olive oil, fish, beans, whole grains.",
      "macroGuidance": { "proteinPct": 18, "fatPct": 35, "carbsPct": 47 },
      "applicableMacroGuidance": true
    },
    {
      "id": "dash",
      "name": "DASH diet",
      "description": "Dietary Approaches to Stop Hypertension. Low sodium, high potassium, calcium, and magnesium through vegetables, fruits, low-fat dairy, and whole grains.",
      "macroGuidance": { "proteinPct": 18, "fatPct": 27, "carbsPct": 55 },
      "applicableMacroGuidance": true
    },
    {
      "id": "paleo",
      "name": "Paleo",
      "description": "Whole foods resembling pre-agricultural diet: meat, fish, eggs, vegetables, fruits, nuts, seeds. Excludes grains, legumes, dairy, and processed foods.",
      "macroGuidance": { "proteinPct": 30, "fatPct": 40, "carbsPct": 30 },
      "applicableMacroGuidance": true
    },
    {
      "id": "weightwatchers",
      "name": "WeightWatchers (WW)",
      "description": "Points-based system that encourages low-calorie-density foods; no foods are off-limits but portion control and food quality are tracked via a points budget.",
      "macroGuidance": null,
      "applicableMacroGuidance": false,
      "guidanceNote": "Points-based rather than macro-based. No fixed percentage split."
    },
    {
      "id": "intermittent-fasting",
      "name": "Intermittent fasting",
      "description": "Cycling between eating and fasting windows (e.g. 16:8, 5:2). Food quality is not prescribed; focus is on when to eat rather than what to eat.",
      "macroGuidance": null,
      "applicableMacroGuidance": false,
      "guidanceNote": "Timing-based pattern. Macro split depends on user preference."
    },
    {
      "id": "ketogenic",
      "name": "Ketogenic (Keto)",
      "description": "Very low carbohydrate, high fat intake designed to shift the body into ketosis. Strictly limits carbs to ~5% of calories.",
      "macroGuidance": { "proteinPct": 25, "fatPct": 70, "carbsPct": 5 },
      "applicableMacroGuidance": true
    },
    {
      "id": "volumetrics",
      "name": "Volumetrics",
      "description": "Prioritises high-volume, low-calorie-density foods (vegetables, fruits, broth-based soups) to promote satiety while managing calorie intake.",
      "macroGuidance": { "proteinPct": 20, "fatPct": 20, "carbsPct": 60 },
      "applicableMacroGuidance": true
    },
    {
      "id": "protein-focused",
      "name": "Protein-focused",
      "description": "Higher protein intake to support muscle retention or growth. Often used alongside strength training. Protein typically ≥30% of calories.",
      "macroGuidance": { "proteinPct": 35, "fatPct": 30, "carbsPct": 35 },
      "applicableMacroGuidance": true
    },
    {
      "id": "healthy-fats",
      "name": "Healthy fats emphasis",
