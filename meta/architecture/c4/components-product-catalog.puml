  Component(authoring, "COMP-009 Product Authoring", "Python", "CAP-003: AddProduct/EditProduct/DeleteProduct (CMD-006/007/008); enforces INV-004/005/006/007")
  Component(weekflag, "COMP-010 WeekFlag Manager", "Python", "CAP-003: SetProductWeekFlag (CMD-009, EVT-009); serves 'This week' query to CTX-004 (CTXREL-006, ADR-0002)")
  Component(scheduler, "COMP-011 Rollover Scheduler", "Python", "CAP-003: PromoteNextWeekFlags (CMD-010, POL-001, EVT-010) every Monday; auto-clears old this-week flags (ADR-0009)")
  Component(importer, "COMP-025 Catalog Importer", "Python (CLI)", "FR-038/ADR-0013: one-time bulk import of global products from USDA FoodData Central CSVs; idempotent upsert on (source, external_id)")
  ComponentDb(catalogDb, "COMP-012 Catalog DB", "PostgreSQL", "Product (lang-neutral) + source/external_id provenance, units, WeekFlag (AGG-002); product/category/diet-tag translation tables + controlled vocab, per-locale indexes (FR-037, ADR-0012)")
}

Container_Ext(frontend, "Web Frontend", "Next.js")
Container_Ext(identity, "Identity Service", "CTX-001")
Container_Ext(planning, "Meal Planning Service", "CTX-004")
