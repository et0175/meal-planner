Rel(frontend, query, "Browse / search / filter / sort / detail", "REST")
Rel(frontend, authoring, "Add / edit / delete product", "REST")
Rel(frontend, weekflag, "Set / clear week flag", "REST")

Rel(authoring, identity, "Validate session (CTXREL-001)", "REST")
Rel(weekflag, identity, "Validate session (CTXREL-001)", "REST")

Rel(planning, weekflag, "Read 'This week' flagged products at render (CTXREL-006, ADR-0002)", "REST")

Rel(query, catalogDb, "Reads", "SQL")
Rel(authoring, catalogDb, "Reads/writes", "SQL")
Rel(weekflag, catalogDb, "Reads/writes flags", "SQL")
Rel(scheduler, catalogDb, "Promotes / clears flags", "SQL")

Rel(importer, usda, "Reads FoodData Central CSV bulk export (FR-038, CON-008)", "file")
Rel(importer, catalogDb, "Idempotent upsert of global products (source, external_id)", "SQL")
