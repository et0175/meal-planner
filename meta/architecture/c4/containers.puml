'   - MealPlanner Monolith (single deployable; hosts all 4 bounded contexts)
'     - CTX-001 Catalog module
'     - CTX-002 Identity module
'     - CTX-003 Nutrition Tracking module
'     - CTX-004 Meal Planning module
'   - PostgreSQL Database (single shared DB; cross-context reads via named repositories)
' ============================================================

title MealPlanner — Containers (MVP1 Monolith)

Person(user, "User / Nutritionist", "ACT-001, ACT-002")

System_Boundary(mealplanner, "MealPlanner") {

  Container(webapp, "Web Application", "Browser SPA", "Renders product catalog, recipe analyser, meal planner canvas, nutrition log, and personal cabinet. Served by the monolith.")

  Container(monolith, "MealPlanner Monolith", "Go / HTTP", "Single deployable unit hosting all four bounded contexts as in-process modules. Handles routing, authentication middleware, command dispatch, and cross-context wiring (composition root).")

  ContainerDb(db, "PostgreSQL Database", "PostgreSQL", "Single shared database for MVP1. Each bounded context owns its tables. Cross-context reads (CatalogReadRepository) are read-only and go through named repository abstractions (ADR-0007).")

}

System_Ext(openai, "OpenAI API", "EXT-001: GPT-4o structured outputs for recipe import (ADR-0002)")
System_Ext(openfoodfacts, "OpenFoodFacts", "EXT-002: bulk product dataset — one-time catalog seeding (ADR-0001)")
System_Ext(identityprovider, "Identity Provider (future)", "EXT-003: reserved for social login (CON-002)")

Rel(user, webapp, "Uses", "HTTPS")
Rel(webapp, monolith, "API calls", "HTTPS/REST/JSON")

Rel(monolith, db, "Reads/writes (all contexts)", "SQL/ORM")
Rel(monolith, openai, "Recipe import: sends extracted text, receives structured JSON (ADR-0002)", "HTTPS/REST")
Rel(openfoodfacts, monolith, "One-time bulk product import at deployment (ADR-0001)", "File / import job")
Rel(monolith, identityprovider, "Reserved: future OAuth2 flows (CON-002)", "HTTPS (deferred)")

note right of monolith
  Cross-context wiring (inside monolith):
  - Catalog → Meal Planning: WeeklySelectionSyncService in-process call (DEC-005/ADR-0005)
  - Identity data in JWT claims; no per-request Identity module call (DEC-006/ADR-0006)
  - Nutrition Tracking + Meal Planning read Catalog tables via CatalogReadRepository (DEC-007/ADR-0007)
end note

