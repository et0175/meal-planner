# ── Identity service ──────────────────────────────────────────────────────────
# Connection string for the Identity PostgreSQL database.
# asyncpg driver required; Railway injects this automatically.
IDENTITY_DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity

# ── Catalog service ───────────────────────────────────────────────────────────
CATALOG_DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5436/catalog

# URL of the Identity service (used by Catalog, Planning, Shopping to validate tokens).
IDENTITY_SERVICE_URL=http://localhost:8001

# ── Planning service ──────────────────────────────────────────────────────────
PLANNING_DATABASE_URL=postgresql+asyncpg://planning:planning@localhost:5434/planning
CATALOG_SERVICE_URL=http://localhost:8002

# ── Shopping service ──────────────────────────────────────────────────────────
SHOPPING_DATABASE_URL=postgresql+asyncpg://shopping:shopping@localhost:5435/shopping
PLANNING_SERVICE_URL=http://localhost:8003

# ── Next.js frontend (NEXT_PUBLIC_* vars are exposed to the browser) ──────────
# Point to Railway service URLs in production; localhost ports in local dev.
NEXT_PUBLIC_IDENTITY_URL=http://localhost:8001
NEXT_PUBLIC_CATALOG_URL=http://localhost:8002
NEXT_PUBLIC_PLANNING_URL=http://localhost:8003
NEXT_PUBLIC_SHOPPING_URL=http://localhost:8004

# ── Next.js server-side service URLs (not exposed to the browser) ─────────────
# Used by RSC / route handlers / middleware inside the Next.js container.
# Values below are for running Next.js directly on your host (outside Docker).
# In Docker Compose, docker-compose.yml overrides these with Docker service names.
# In production, set to Railway private network URLs.
IDENTITY_URL=http://localhost:8001
CATALOG_URL=http://localhost:8002
PLANNING_URL=http://localhost:8003
SHOPPING_URL=http://localhost:8004

# ── LOCAL DEV ONLY: per-service DATABASE_URL ──────────────────────────────────
# When running a service directly (outside Docker), create backend/<service>/.env
# with DATABASE_URL set for that service. In production and Docker Compose, each
# service receives DATABASE_URL from its own environment — do NOT share one var.
#
# Example for identity (backend/identity/.env):
#   DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity
